<% turbo_page_requires_reload %>
<!-- Where the page reaches ringo, which is always through trailmap: a
     WebSocket for the event stream, a prefix for the controls, and the
     reviewer list the stream does not carry. On an element rather than in an
     inline <script> so the page needs no inline JavaScript. -->
<div id="fleetConfig" hidden data-socket-path="<%= @socket_path %>" data-control-path="<%= @control_path %>" data-reviewers-path="<%= @reviewers_path %>" data-read-path="<%= @read_path %>"></div>

<h1 class="sr-only">Dashboard</h1>

<% unless @relay_configured %>
  <div class="card ci-fixer">
    <div class="card-head"><span class="card-title">No fleet data</span></div>
    <div class="field-note">This deployment has no ringo origin — neither the <code>ringo_base</code> setting nor <code>RINGO_BASE</code> — so trailmap has no ringo to relay. See docs/fleet-dashboard.md.</div>
  </div>
<% end %>

<div class="fleet-header">
  <div class="status-group" title="Connection status">
    <span class="pill" id="eventsPill" title="Dashboard event stream"><span class="connected off" id="eventsDot"></span><span class="label">events</span></span>
    <span class="pill" id="tmuxPill" title="tmux socket to agent panes"><span class="connected off" id="tmuxDot"></span><span class="label">tmux</span></span>
    <span id="mainCIPills"></span>
    <button type="button" class="pill" id="watchPill" data-action="refresh-usage" title="claude.ai usage scraper (local browser watch)" style="display:none"><span class="connected off" id="watchDot"></span><span class="label">usage scraper</span><span class="action">&#10227;</span></button>
    <span class="pill" id="pullFailPill" style="display:none"><span class="connected off" id="pullFailDot"></span><span class="label" id="pullFailLabel">pull failed</span></span>
    <span id="agentPills"></span>
  </div>
</div>

<!-- Usage and Loop fold to their summary line below 700px; on a wide page
     dashboard.js keeps them open and their summary out of the tab order. -->
<div class="top-pair">
<details class="card fold" id="usageGroup" open>
  <summary class="card-head"><span class="card-title">Usage</span><span class="field-note" id="usageSummary"></span></summary>
  <div class="usage-bar" id="usageBar" style="display:none"></div>
  <div class="usage-bar" id="codexUsageBar" style="display:none"></div>
</details>

<details class="card fold" id="spawnLoopPanel" open>
  <summary class="card-head">
    <span class="card-title">Loop</span>
    <span class="field-note" id="loopSummary"></span>
    <span class="field-note loop-paused" data-why="loop">paused: the loop is stopped</span>
  </summary>
  <!-- As in the mockup: the caps, the interval and the bundle switch on
       one row; the loop's own buttons and timing on a quiet line under it;
       the next bundle's stories folded away. -->
  <div class="loop-row">
    <label class="field"><span>Live cap <span class="field-note" id="slLiveNow"></span></span>
      <input id="slLiveCap" class="ctl num" type="number" min="1">
    </label>
    <label class="field"><span>Queue cap <span class="field-note" id="slOpenNow"></span></span>
      <input id="slQueueCap" class="ctl num" type="number" min="1">
    </label>
    <label class="field" title="Minutes between ticks (min 1)">Every (min)
      <input id="slStagger" class="ctl num" type="number" min="1" step="1">
    </label>
    <label class="field" title="Bundle mode: each tick spawns ONE worker for the whole next-bundle (a PR closing several stories). Off: one worker per single story.">Bundle
      <input id="slBundle" class="switch" type="checkbox" role="switch">
    </label>
  </div>
  <div class="loop-line">
    <span class="loop-controls" id="slControls"></span>
    <span class="field-note" id="slLastSpawn"></span>
  </div>
  <details class="bundle-fold" id="slBundleFold" style="display:none">
    <summary class="field-note">Stories in the next bundle</summary>
    <div id="slBundleList" class="bundle-list"></div>
  </details>
  <div class="card-head">
    <button class="btn btn-red btn-sm" id="pokeBtn" data-action="poke" data-panes="" title="Send &quot;keep going&quot; to every red (API-error / stuck-retry) agent" style="display:none">poke stalled agents</button>
    <% [ [ "codex", "Codex" ], [ "claude", "Claude" ] ].each do |from, name| %>
      <span class="card-head" id="drain<%= name %>Field" style="display:none" title="<%= name %> out of usage for a while? Move every <%= from %> reviewer that still owes a review onto the other agent, killing its stranded pane first.">
        <span class="field-note">Stranded reviewers</span>
        <button class="btn btn-sm" data-action="drain-reviewers" data-from="<%= from %>" data-status="drain<%= name %>Status">Drain <%= from %></button>
        <span class="field-status" id="drain<%= name %>Status"></span>
      </span>
    <% end %>
  </div>
</details>
</div>

<div id="queueSection" class="card" style="display:none"></div>

<!-- The list's toolbar, as GitHub's pull request list has one: the search
     field, then the actions, the primary one last. -->
<div class="list-toolbar">
  <input type="search" id="fleetSearch" class="ctl" placeholder="Search sessions, stories and PRs" aria-label="Search sessions, stories and PRs" data-ui="palette-open" data-mode="search" readonly>
  <button type="button" id="fleetSearchBtn" class="btn" data-ui="palette-open" data-mode="search" aria-label="Search" title="Search sessions, stories and PRs (⌘K)"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"></path></svg></button>
  <button type="button" class="btn" id="broadcastBtn" data-ui="broadcast-open">Broadcast</button>
  <button type="button" class="btn btn-primary" id="spawnBtn" data-ui="spawn-open">Spawn</button>
  <span class="field-status" id="paletteDone" role="status" aria-live="polite"></span>
</div>

<div id="repoSections"></div>

<!-- The ⌘K palette: search, and the message action that used to be a
     form on the page. A modal dialog, so focus stays in it. -->
<dialog id="palette" class="palette" aria-label="Search">
  <div class="palette-input">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z"></path></svg>
    <input id="paletteInput" type="text" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="paletteResults" aria-autocomplete="list" aria-label="Search sessions, stories and PRs" placeholder="Search sessions, stories and PRs">
    <kbd>esc</kbd>
    <button type="button" class="palette-cancel" data-ui="palette-close">Cancel</button>
    <button type="button" class="palette-x" data-ui="palette-close" aria-label="Close" title="Close (esc)"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.749.749 0 0 1 1.275.326.749.749 0 0 1-.215.734L9.06 8l3.22 3.22a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L8 9.06l-3.22 3.22a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"></path></svg></button>
  </div>
  <div class="palette-mode" id="paletteMode" hidden>
    <span id="paletteModeLabel"></span>
    <button type="button" class="btn btn-sm" data-ui="palette-back">&larr; Search</button>
  </div>
  <div class="palette-scopes" id="paletteScopes" role="group" aria-label="Scope"></div>
  <div class="palette-body" id="paletteResults" role="listbox" aria-label="Results"></div>
  <div class="palette-pane" data-pane-mode="message" hidden>
    <button class="btn btn-primary" id="messageSend" data-action="pane-send" data-pane="" data-key="" data-source="paletteInput" data-clears="paletteInput" data-says="messageNote">Send</button>
    <span class="field-status" id="messageNote"></span>
  </div>
  <div class="palette-foot" data-foot-mode="search"><span><kbd>&uarr;</kbd> <kbd>&darr;</kbd> move</span><span><kbd>&#8629;</kbd> open</span><span><kbd>&#8984;</kbd> <kbd>&#8629;</kbd> message session</span><span><kbd>esc</kbd> close</span></div>
  <div class="palette-foot" data-foot-mode="message" hidden><span><kbd>&#8629;</kbd> send</span><span><kbd>esc</kbd> close</span></div>
</dialog>

<!-- The spawn dialog. Its own dialog, not a palette mode: a task is often a
     long prompt, so it gets a box that grows with it. The repos are a row in
     the viewer's order (⌥1–9 picks, ⌥[ ⌥] rearranges, kept in this browser);
     the select under them is the value the request reads. The options start
     at the loop's own. -->
<dialog id="spawnDialog" class="palette spawn-dialog" aria-labelledby="spawnTitle">
  <div class="palette-mode">
    <span id="spawnTitle">Spawn a session</span>
    <button type="button" class="palette-cancel" data-ui="spawn-close">Cancel</button>
    <button type="button" class="palette-x" data-ui="spawn-close" aria-label="Close" title="Close (esc)"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.749.749 0 0 1 1.275.326.749.749 0 0 1-.215.734L9.06 8l3.22 3.22a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L8 9.06l-3.22 3.22a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"></path></svg></button>
  </div>
  <div class="spawn-repos" id="spawnRepos" role="radiogroup" aria-label="Repository"></div>
  <select id="repo" class="ctl" aria-label="Repository" hidden>
    <% if @repos.empty? && @missing_checkout %>
    <option value="" disabled selected>no repository has a checkout path</option>
    <% elsif @repos.empty? %>
    <option value="" disabled selected>no repos configured (FLEET_REPO_PATHS)</option>
    <% end %>
    <% @repos.each do |repo| %>
    <option value="<%= repo.path %>"><%= repo.name %></option>
    <% end %>
  </select>
  <textarea id="spawnTask" class="spawn-task" rows="4" aria-label="Describe the task for a new session" placeholder="Describe the task for a new session"></textarea>
  <div class="spawn-options">
    <label class="field">Model
      <select id="spawnModel" class="ctl"><option value="">Loop default</option></select>
    </label>
    <label class="field">Worktree
      <input id="spawnName" class="ctl" type="text" autocomplete="off" spellcheck="false" placeholder="task">
    </label>
    <span class="field-note" id="spawnNameNote">+ a random suffix, as the loop names its own</span>
  </div>
  <div class="palette-pane">
    <button class="btn btn-primary" id="spawn" data-action="spawn">Spawn</button>
    <span class="field-status" id="spawnStatus"></span>
    <% if @repos.empty? && @missing_checkout %>
      <span class="field-note" id="checkoutNote">Set one in <a href="<%= repo_settings_path(*@missing_checkout.split("/", 2)) %>"><%= @missing_checkout %>'s settings</a>.</span>
    <% end %>
  </div>
  <div class="palette-foot"><span><kbd>&#8984;</kbd> <kbd>&#8629;</kbd> spawn</span><span><kbd>&#8997;</kbd> <kbd>1</kbd>&ndash;<kbd>9</kbd> repo</span><span><kbd>&#8997;</kbd> <kbd>[</kbd> <kbd>]</kbd> reorder</span><span><kbd>&#8997;</kbd> <kbd>0</kbd> reset order</span><span><kbd>esc</kbd> close</span></div>
</dialog>

<!-- The broadcast dialog. Its own dialog, as spawn has: a broadcast is often
     a paragraph, so it gets a box that grows with it, where a bare Enter is a
     newline. ⌘↵ sends to every agent, ⌘⇧↵ only to the CI-red ones; each
     audience's button carries its size. -->
<dialog id="broadcastDialog" class="palette spawn-dialog" aria-labelledby="broadcastTitle">
  <div class="palette-mode">
    <span id="broadcastTitle">Broadcast to the agents</span>
    <button type="button" class="palette-cancel" data-ui="broadcast-close">Cancel</button>
    <button type="button" class="palette-x" data-ui="broadcast-close" aria-label="Close" title="Close (esc)"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.749.749 0 0 1 1.275.326.749.749 0 0 1-.215.734L9.06 8l3.22 3.22a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L8 9.06l-3.22 3.22a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z"></path></svg></button>
  </div>
  <textarea id="broadcastMessage" class="spawn-task" rows="4" aria-label="Message to broadcast to the agents" placeholder="Message to broadcast to the agents"></textarea>
  <div class="spawn-options">
    <span class="field-note">&#128227; Typed into each agent's pane exactly as if you had typed it there.</span>
  </div>
  <div class="palette-pane">
    <button class="btn btn-primary" id="bcastAll" data-action="broadcast" data-target="all" title="Send to every live worker pane">all</button>
    <button class="btn" id="bcastCIRed" data-action="broadcast" data-target="ci-red" title="Send only to workers whose PR is failing CI" style="display:none">CI red</button>
    <span class="field-status" id="bcastNote"></span>
  </div>
  <div class="palette-foot"><span><kbd>&#8984;</kbd> <kbd>&#8629;</kbd> <span id="bcastKeyHint">send to all</span></span><span><kbd>&#8984;</kbd> <kbd>&#8679;</kbd> <kbd>&#8629;</kbd> send to CI red</span><span><kbd>esc</kbd> close</span></div>
</dialog>

<script src="<%= javascript_path("dashboard") %>" type="module"></script>
