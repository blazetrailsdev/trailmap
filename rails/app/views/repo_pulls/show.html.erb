<%= render "shared/repo_header" %>

<div class="page-header">
  <h1 class="page-title">#<%= @number %> <span class="muted"><%= @ref %></span></h1>
  <div class="page-subhead"><a href="<%= @href %>">Open on GitHub &rarr;</a></div>
</div>

<div class="box">
  <% if @stories.empty? %>
    <div class="empty">No story is stamped <code><%= @ref %></code>.</div>
  <% end %>
  <% @stories.each do |story| %>
    <div class="item-row">
      <span class="row-main">
        <span class="titleline">
          <a class="row-title" href="/<%= @nwo %>/issues/<%= story.id %>"><%= story.title %></a>
          <%= render "shared/status_badge", status: story.status %>
        </span>
        <div class="row-meta"><code><%= story.id %></code></div>
      </span>
    </div>
  <% end %>
</div>
