<%= render "shared/repo_header" %>

<%= render "shared/filter_tabs", tabs: [
  RfcPagesController::Tab.new(href: repo_pulls_path(@owner.login, @repo.name, state: "open"), label: "Open", count: @tab_counts[:open], active: @state == "open"),
  RfcPagesController::Tab.new(href: repo_pulls_path(@owner.login, @repo.name, state: "merged"), label: "Merged", count: @tab_counts[:merged], active: @state == "merged"),
] %>

<p class="muted">A pull request exists here because a story was stamped with it
(<code>stories.pr</code>). &ldquo;Merged&rdquo; means every story under it is done or closed —
the only merge signal this database holds.</p>

<div class="box">
  <% if @rows.empty? %>
    <div class="empty">No <%= @state %> pull requests.</div>
  <% end %>
  <% @rows.each do |row| %>
    <div class="item-row">
      <span class="row-main">
        <span class="titleline">
          <a class="row-title" href="<%= repo_pull_path(@owner.login, @repo.name, row.number) %>">#<%= row.number %></a>
          <span class="tag prog"><%= row.stories.size %> <%= row.stories.size == 1 ? "story" : "stories" %></span>
          <a class="tag" href="<%= row.href %>">on GitHub</a>
        </span>
        <div class="row-meta">
          <% row.stories.each do |story| %>
            <a href="<%= repo_issue_path(@owner.login, @repo.name, story.id) %>"><%= story.title %></a>
            <%= render "shared/status_badge", status: story.status %>
          <% end %>
        </div>
      </span>
    </div>
  <% end %>
</div>
