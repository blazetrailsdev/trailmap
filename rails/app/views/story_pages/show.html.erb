<% if @story.nil? %>
  <div class="page-header"><h1 class="page-title">Story not found</h1></div>
  <p class="muted">No story in the index has the id <code><%= @id %></code>.</p>
<% else %>
  <% rfc_label = @rfc.nil? ? @story.rfc_id : (@rfc.title || @story.rfc_id) %>
  <div class="page-header">
    <h1 class="page-title"><%= @story.title || @story.id %></h1>
    <div class="page-subhead">
      <span class="id"><%= @story.id %></span>
      <%= render "shared/status_state", status: @shown_status, label: @held_label %>
      <span class="muted">
        in <a href="/rfc/<%= @story.rfc_id %>"><%= rfc_label %></a><% unless @story.pr.nil? %>, PR <%= @story.pr %><% end %>
      </span>
    </div>
  </div>

  <% if @refusal %>
    <p class="flash flash-error"><%= @refusal %></p>
  <% end %>

  <div class="layout">
    <div>
      <% if @story.blocked_by.present? %>
        <p class="note"><strong>Blocked:</strong> <%= @story.blocked_by %></p>
      <% end %>
      <% if @story.closed_reason.present? %>
        <p class="note"><strong>Closed:</strong> <%= @story.closed_reason %></p>
      <% end %>

      <% if @graph.blocked_by.any? || @graph.blocks.any? %>
        <% [
          { title: "Blocked by", note: "everything this story waits on", nodes: @graph.blocked_by },
          { title: "Blocks", note: "everything waiting on this story", nodes: @graph.blocks },
        ].each do |side| %>
          <% if side[:nodes].any? %>
            <div class="box dep-graph">
              <div class="box-header">
                <span class="count"><%= side[:title] %> <span class="n"><%= side[:nodes].size %></span></span>
                <span class="muted"><%= side[:note] %>, transitively<% if @graph.cyclic %> · this story is in a dependency cycle<% end %></span>
              </div>
              <% side[:nodes].each do |node| %>
                <div class="item-row" style="padding-left: <%= 16 + (node.depth - 1) * 20 %>px">
                  <%= render "shared/status_badge", status: node.status %>
                  <span class="row-main">
                    <a class="row-title" href="/story/<%= node.id %>"><%= node.title || node.id %></a>
                    <div class="row-meta"><%= node.id %><% unless node.via.nil? %> · via <%= node.via %><% end %></div>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% if @deps.any? || @rfc_deps.any? %>
        <div class="box">
          <div class="box-header"><span class="count">Depends on</span></div>
          <% @deps.each do |dep| %>
            <div class="item-row">
              <%= render "shared/status_badge", status: dep.status %>
              <span class="row-main">
                <a class="row-title" href="/story/<%= dep.id %>"><%= dep.id %></a>
              </span>
            </div>
          <% end %>
          <% @rfc_deps.each do |dep| %>
            <div class="item-row">
              <%= render "shared/status_badge", status: dep.status %>
              <span class="row-main">
                <a class="row-title" href="/rfc/<%= dep.id %>"><%= dep.id %></a>
                <div class="row-meta">RFC</div>
              </span>
            </div>
          <% end %>
        </div>
      <% end %>

      <h2 class="section-title">Document</h2>
      <%= render "shared/document", body: @body, error: @error %>
    </div>

    <div class="side">
      <% if @actions.to_h.values.any? %>
        <div class="side-section rfc-actions">
          <div class="side-head">Lifecycle</div>
          <% if @actions.spawn %>
            <button type="button" class="btn" data-relay="spawnloop/story-spawn" data-payload="<%= { id: @story.id }.to_json %>" data-confirm="Spawn a worker for <%= @story.id %> now, using the current loop settings?">Spawn worker</button>
            <div class="field-note" data-relay-status hidden></div>
          <% end %>
          <% if @actions.ready %>
            <%= button_to "Mark ready", "/story/#{@story.id}/ready", class: "btn" %>
          <% end %>
          <% if @actions.top %>
            <%= button_to "Top of queue", "/story/#{@story.id}/top", class: "btn" %>
          <% end %>
          <% if @actions.release %>
            <%= button_to "Release claim", "/story/#{@story.id}/release", form: { "data-confirm": "Release this claim? The story goes back to ready." }, class: "btn" %>
          <% end %>
          <% [ [ @actions.block, "block", "Block" ], [ @actions.close, "close", "Close story" ] ].each do |show, path, label| %>
            <% if show %>
              <%= form_with url: "/story/#{@story.id}/#{path}", method: :post do %>
                <input class="input" name="reason" placeholder="Reason" aria-label="<%= label %> reason">
                <button type="submit" class="btn"><%= label %></button>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <div class="side-section">
        <div class="side-head">RFC</div>
        <div class="side-value">
          <a href="/rfc/<%= @story.rfc_id %>"><%= rfc_label %></a>
          <% if @rfc %>
            <%= render "shared/status_badge", status: @rfc.status %>
          <% end %>
        </div>
      </div>
      <div class="side-section">
        <div class="side-head">Assignee</div>
        <div class="side-value"><%= @story.assignee.presence || "No one assigned" %></div>
      </div>
      <div class="side-section">
        <div class="side-head">Est LOC</div>
        <div class="side-value"><%= @story.est_loc.nil? ? "Unsized" : @story.est_loc %></div>
      </div>
      <div class="side-section">
        <div class="side-head">Priority</div>
        <div class="side-value"><%= @story.priority.nil? ? "Unset" : "p#{@story.priority}" %></div>
      </div>
      <% if @story.cluster.present? %>
        <div class="side-section">
          <div class="side-head">Cluster</div>
          <div class="side-value"><%= @story.cluster %></div>
        </div>
      <% end %>
      <div class="side-section">
        <div class="side-head">Packages<%= @inherited ? " (from RFC)" : "" %></div>
        <div class="side-value">
          <% if @packages.empty? %>None<% else %>
            <span class="side-list">
              <% @packages.each do |name| %><span class="badge"><%= name %></span><% end %>
            </span>
          <% end %>
        </div>
      </div>
      <% unless @story.pr.nil? %>
        <div class="side-section">
          <div class="side-head">PR</div>
          <div class="side-value"><%= @story.pr %></div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
<script src="<%= javascript_path("rfc-actions") %>" type="module"></script>
