<%= render "shared/repo_header" %>

<% if @rfc.nil? %>
  <div class="box"><div class="empty">No RFC <code><%= @id %></code>.</div></div>
<% else %>
  <div class="page-header">
    <h1 class="page-title"><%= @rfc.title || @rfc.id %>
      <%= render "shared/status_badge", status: @rfc.status %>
    </h1>
    <div class="page-subhead"><span class="muted"><code><%= @rfc.id %></code> &middot;
      <a href="<%= rfc_path(@rfc.id) %>">RFC page</a></span></div>
  </div>

  <p class="muted">This repository's stories only, by status.</p>
  <% if @columns.empty? %>
    <div class="box"><div class="empty">No story of this RFC belongs to this repository.</div></div>
  <% end %>
  <% @columns.each do |column| %>
    <h2><%= render "shared/status_badge", status: column.status %>
      <span class="muted"><%= column.stories.size %></span></h2>
    <div class="box">
      <% column.stories.each do |story| %>
        <div class="item-row">
          <span class="row-main">
            <span class="titleline">
              <a class="row-title" href="<%= repo_issue_path(@owner.login, @repo.name, story.id) %>"><%= story.title %></a>
            </span>
            <div class="row-meta"><code><%= story.id %></code></div>
          </span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
