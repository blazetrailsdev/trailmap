<%= render "shared/repo_header" %>

<% if @row.nil? %>
  <div class="box"><div class="empty">No story <code><%= @id %></code>.</div></div>
<% else %>
  <div class="page-header">
    <h1 class="page-title"><%= @row.title %>
      <%= render "shared/status_badge", status: @row.status %>
    </h1>
    <div class="page-subhead"><span class="muted"><code><%= @row.id %></code></span></div>
  </div>

  <div class="box">
    <div class="box-row"><strong>RFC</strong> &middot; <a href="<%= rfc_path(@row.rfc_id) %>"><%= @row.rfc_id %></a></div>
    <div class="box-row"><strong>Pull request</strong> &middot;
      <% if @row.pr.present? %><%= @row.pr %><% else %><span class="muted">none yet</span><% end %>
    </div>
    <div class="box-row"><strong>Assignee</strong> &middot;
      <% if @row.assignee.present? %><%= @row.assignee %><% else %><span class="muted">unclaimed</span><% end %>
    </div>
    <div class="box-row"><strong>Estimate</strong> &middot;
      <% if @row.est_loc.to_i != 0 %><%= @row.est_loc %> loc<% else %><span class="muted">none</span><% end %>
    </div>
  </div>

  <%# The body is the story page's job; this tab is the repo-scoped view. %>
  <p><a href="<%= story_path(@row.id) %>">Open the story page &rarr;</a></p>
<% end %>
