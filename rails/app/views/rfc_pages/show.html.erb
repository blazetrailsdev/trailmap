<% if @rfc.nil? %>
  <div class="page-header"><h1 class="page-title">RFC not found</h1></div>
  <p class="muted">No RFC in the index has the id <code><%= @id %></code>.</p>
<% else %>
  <div class="page-header">
    <h1 class="page-title"><%= @rfc.title || @rfc.id %></h1>
    <div class="page-subhead">
      <span class="id"><%= @rfc.id %></span>
      <%= render "shared/status_state", status: @rfc.status %>
      <span class="muted"><%= @counts.total %> <%= @counts.total == 1 ? "story" : "stories" %></span>
    </div>
  </div>

  <% if @refusal %>
    <p class="flash flash-error"><%= @refusal %></p>
  <% end %>

  <% rfc_tabs = [
    { key: "stories", label: "Stories", href: rfc_path(@rfc.id), count: @counts.total },
    { key: "refinements", label: "Refinements", href: rfc_refinements_path(@rfc.id), count: @refine_count },
  ] %>
  <div class="tabs">
    <% rfc_tabs.each do |tab| %>
      <a class="tab<%= " active" if tab[:key] == @tab %>" href="<%= tab[:href] %>"<% if tab[:key] == @tab %> aria-current="page"<% end %>><%= tab[:label] %><% unless tab[:count].nil? %> <span class="Counter"><%= tab[:count] %></span><% end %></a>
    <% end %>
  </div>

  <div class="layout">
    <div>
      <% if @tab == "refinements" %>
        <% latest, *earlier = @refines %>
        <% if latest.nil? %>
          <div class="box"><div class="empty">No refine report yet. Run “Refine stories” to have an agent groom this RFC’s stories.</div></div>
        <% else %>
          <div class="box refine-latest">
            <div class="box-header">
              <span class="Label refine-<%= latest.outcome %>"><%= latest.outcome %></span>
              <time class="muted" datetime="<%= latest.at.utc.iso8601(3) %>"><%= latest.at.utc.iso8601[0, 16].tr("T", " ") %> UTC</time>
            </div>
            <article class="markdown"><% if latest.html %><%= latest.html %><% else %><p class="muted">The report has no summary.</p><% end %></article>
          </div>
          <% if earlier.any? %>
            <h2 class="section-title">Earlier reports</h2>
            <div class="box">
              <% earlier.each do |refine| %>
                <div class="item-row"><details class="refine-earlier">
                  <summary>
                    <span class="Label refine-<%= refine.outcome %>"><%= refine.outcome %></span>
                    <time class="muted" datetime="<%= refine.at.utc.iso8601(3) %>"><%= refine.at.utc.iso8601[0, 16].tr("T", " ") %> UTC</time>
                  </summary>
                  <article class="markdown"><% if refine.html %><%= refine.html %><% else %><p class="muted">The report has no summary.</p><% end %></article>
                </details></div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% else %>
      <% if @counts.total.positive? %>
        <div class="progress-line">
          <span class="pct"><%= @counts.done_pct %>% complete</span>
          <span class="progress"><span class="progress-fill" style="width:<%= @counts.done_pct %>%"></span></span>
          <span class="muted"><%= @counts.done %>/<%= @counts.total %> done</span>
        </div>
      <% end %>

      <div class="box">
        <div class="box-header">
          <span class="count"><%= @counts.open %> <span class="n">open</span></span>
          <span class="count"><%= @counts.done %> <span class="n">done</span></span>
        </div>
        <% if @stories.empty? %>
          <div class="empty">No stories under this RFC yet.</div>
        <% end %>
        <% @stories.each do |story| %>
          <div class="item-row">
            <%= render "shared/status_badge", status: story.status %>
            <span class="row-main">
              <a class="row-title" href="<%= story_path(story.id) %>"><%= story.title %></a>
              <div class="row-meta">
                <%= story.id %><% if story.est_loc.to_i != 0 %> &middot; <%= story.est_loc %> loc<% end %><% if story.cluster.present? %> &middot; <%= story.cluster %><% end %><% unless story.priority.nil? %> &middot; p<%= story.priority %><% end %>
              </div>
            </span>
          </div>
        <% end %>
      </div>

      <h2 class="section-title">Document</h2>
      <%= render "shared/document", body: @body, error: @error %>
      <% end %>
    </div>

    <div class="side">
      <% if @moves.any? || @has_drafts %>
        <div class="side-section rfc-actions">
          <div class="side-head">Lifecycle</div>
          <% @moves.each do |move| %>
            <%= button_to move.label, rfc_status_path(@rfc.id), params: { status: move.to }, form: { "data-confirm": move.confirm }, class: "btn" %>
          <% end %>
          <% if @has_drafts %>
            <%= button_to "Mark drafts ready", rfc_ready_drafts_path(@rfc.id), form: { "data-confirm": "Mark every draft story under this RFC ready? All or nothing." }, class: "btn" %>
          <% end %>
        </div>
      <% end %>
      <div class="side-section rfc-actions">
        <div class="side-head">Dispatch</div>
        <% if @can_batch %>
          <button type="button" class="btn btn-primary" data-relay="spawnloop/rfc-batch-spawn" data-payload="<%= { slug: @rfc.id }.to_json %>" data-confirm="Spawn one worker for the next batch of stories under <%= @rfc.id %>?">Spawn batch</button>
        <% end %>
        <textarea class="ctl" rows="3" data-relay-note aria-label="Message for the agent" placeholder="Optional message for the agent (steers this refine pass)…"></textarea>
        <button type="button" class="btn" data-relay="spawnloop/rfc-refine" data-payload="<%= { slug: @rfc.id, note: "", mode: "refine" }.to_json %>" data-confirm="Spawn an agent to groom every story under <%= @rfc.id %>?">Refine stories</button>
        <% if @can_sunset %>
          <button type="button" class="btn btn-red" data-relay="spawnloop/rfc-refine" data-payload="<%= { slug: @rfc.id, note: "", mode: "sunset" }.to_json %>" data-confirm="Sunset <%= @rfc.id %>? An agent will re-home its remaining stories and close the RFC unless work is still in flight.">Sunset RFC</button>
        <% end %>
        <div class="field-note" data-relay-status hidden></div>
      </div>
      <div class="side-section rfc-priority">
        <div class="side-head">Priority</div>
        <%= form_with url: rfc_priority_path(@rfc.id), method: :post, class: "rfc-priority-form" do |f| %>
          <%= f.number_field :priority, value: @rfc.priority, min: 0, step: 1, class: "ctl num", placeholder: "Unset", "aria-label": "RFC priority (lower = sooner)" %>
          <%= f.submit "Set", class: "btn btn-sm" %>
        <% end %>
        <% unless @rfc.priority.nil? %>
          <%= button_to "Clear", rfc_priority_path(@rfc.id), params: { priority: "clear" }, class: "btn btn-sm" %>
        <% end %>
        <div class="field-note">Lower is sooner. Stories without their own priority inherit it.</div>
      </div>
      <div class="side-section">
        <div class="side-head">Owner</div>
        <div class="side-value"><%= @rfc.owner.presence || "Nobody" %></div>
      </div>
      <% if @rfc.superseded_by.present? %>
        <div class="side-section">
          <div class="side-head">Superseded by</div>
          <div class="side-value"><a href="<%= rfc_path(@rfc.superseded_by) %>"><code><%= @rfc.superseded_by %></code></a></div>
        </div>
      <% end %>
      <div class="side-section">
        <div class="side-head">Updated</div>
        <div class="side-value"><%= @rfc.updated_on.presence || "Never" %></div>
      </div>
    </div>
  </div>
<% end %>
<script src="<%= javascript_path("rfc-actions") %>" type="module"></script>
