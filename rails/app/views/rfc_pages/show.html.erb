<% if @rfc.nil? %>
  <div class="page-header"><h1 class="page-title">RFC not found</h1></div>
  <p class="muted">No RFC in the index has the id <code><%= @id %></code>.</p>
<% else %>
  <div class="page-header">
    <h1 class="page-title"><%= @rfc.title || @rfc.id %></h1>
    <div class="page-subhead">
      <span class="id"><%= @rfc.id %></span>
      <%= render "shared/status_state", status: @rfc.status %>
      <span class="muted"><%= @counts.total %> <%= @counts.total == 1 ? "story" : "stories" %></span>
    </div>
  </div>

  <% if @refusal %>
    <p class="flash flash-error"><%= @refusal %></p>
  <% end %>

  <div class="layout">
    <div>
      <% if @counts.total.positive? %>
        <div class="progress-line">
          <span class="pct"><%= @counts.done_pct %>% complete</span>
          <span class="progress"><span class="progress-fill" style="width:<%= @counts.done_pct %>%"></span></span>
          <span class="muted"><%= @counts.done %>/<%= @counts.total %> done</span>
        </div>
      <% end %>

      <div class="box">
        <div class="box-header">
          <span class="count"><%= @counts.open %> <span class="n">open</span></span>
          <span class="count"><%= @counts.done %> <span class="n">done</span></span>
        </div>
        <% if @stories.empty? %>
          <div class="empty">No stories under this RFC yet.</div>
        <% end %>
        <% @stories.each do |story| %>
          <div class="item-row">
            <%= render "shared/status_badge", status: story.status %>
            <span class="row-main">
              <a class="row-title" href="/story/<%= story.id %>"><%= story.title %></a>
              <div class="row-meta">
                <%= story.id %><% if story.est_loc.to_i != 0 %> &middot; <%= story.est_loc %> loc<% end %><% if story.cluster.present? %> &middot; <%= story.cluster %><% end %><% unless story.priority.nil? %> &middot; p<%= story.priority %><% end %>
              </div>
            </span>
          </div>
        <% end %>
      </div>

      <h2 class="section-title">Document</h2>
      <%= render "shared/document", body: @body, error: @error %>
    </div>

    <div class="side">
      <% if @moves.any? || @has_drafts %>
        <div class="side-section rfc-actions">
          <div class="side-head">Lifecycle</div>
          <% @moves.each do |move| %>
            <%= button_to move.label, "/rfc/#{@rfc.id}/status", params: { status: move.to }, form: { "data-confirm": move.confirm }, class: "btn" %>
          <% end %>
          <% if @has_drafts %>
            <%= button_to "Mark drafts ready", "/rfc/#{@rfc.id}/ready-drafts", form: { "data-confirm": "Mark every draft story under this RFC ready? All or nothing." }, class: "btn" %>
          <% end %>
        </div>
      <% end %>
      <% if @can_batch || @can_sunset %>
        <div class="side-section rfc-actions">
          <div class="side-head">Dispatch</div>
          <% if @can_batch %>
            <button type="button" class="btn" data-relay="spawnloop/rfc-batch-spawn" data-payload="<%= { slug: @rfc.id }.to_json %>" data-confirm="Spawn one worker for the next batch of stories under <%= @rfc.id %>?">Spawn batch</button>
          <% end %>
          <% if @can_sunset %>
            <button type="button" class="btn" data-relay="spawnloop/rfc-refine" data-payload="<%= { slug: @rfc.id, note: "", mode: "sunset" }.to_json %>" data-confirm="Sunset <%= @rfc.id %>? An agent will re-home its remaining stories and close the RFC unless work is still in flight.">Sunset RFC</button>
          <% end %>
          <div class="field-note" data-relay-status hidden></div>
        </div>
      <% end %>
      <div class="side-section">
        <div class="side-head">Owner</div>
        <div class="side-value"><%= @rfc.owner.presence || "Nobody" %></div>
      </div>
      <% if @rfc.superseded_by.present? %>
        <div class="side-section">
          <div class="side-head">Superseded by</div>
          <div class="side-value"><a href="/rfc/<%= @rfc.superseded_by %>"><code><%= @rfc.superseded_by %></code></a></div>
        </div>
      <% end %>
      <div class="side-section">
        <div class="side-head">Updated</div>
        <div class="side-value"><%= @rfc.updated_on.presence || "Never" %></div>
      </div>
    </div>
  </div>
<% end %>
<script src="<%= javascript_path("rfc-actions") %>" type="module"></script>
