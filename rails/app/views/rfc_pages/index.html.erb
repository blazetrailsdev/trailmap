<div class="page-header">
  <h1 class="page-title">RFCs</h1>
  <div class="page-subhead">
    <span class="muted"><%= @total %> <%= @total == 1 ? "RFC" : "RFCs" %></span>
  </div>
</div>

<%= render "shared/filter_tabs", tabs: @tabs %>

<div class="box">
  <% if @rows.empty? %>
    <div class="empty">No <%= @filter %> RFCs.</div>
  <% end %>
  <% @rows.each do |row| %>
    <div class="item-row">
      <span class="row-main">
        <span class="titleline">
          <a class="row-title" href="<%= rfc_path(row.id) %>"><%= row.title %></a>
          <% unless row.priority.nil? %><span class="tag prio" title="RFC priority (lower = sooner)">P<%= row.priority %></span><% end %>
          <% if row.counts.total.positive? %><span class="tag prog" title="stories done / total"><%= row.counts.done %>/<%= row.counts.total %> done</span><% end %>
          <% if row.stalled %><span class="tag stalled" title="no story ready and none in flight: nothing here can be picked up">needs refine</span><% end %>
          <% row.clusters.each do |cluster| %><span class="tag"><%= cluster %></span><% end %>
          <% if row.superseded_by.present? %><span class="tag">&rarr; <%= row.superseded_by %></span><% end %>
        </span>
        <div class="row-meta">
          <code><%= row.id %></code><% if row.owner.present? %> &middot; by <%= row.owner %><% end %><% unless row.open_days.nil? %> &middot; open <%= row.open_days %>d<% end %>
        </div>
        <% if row.story_total.positive? %>
          <div class="sbarwrap">
            <span class="sbarcap"><%= row.story_total %> <%= row.story_total == 1 ? "story" : "stories" %></span>
            <span class="sbartrack">
              <span class="sbar" style="width:<%= js_num(row.bar_length.pct) %>%">
                <% row.bar.each do |seg| %><span class="seg s-<%= seg.status %>" style="width:<%= js_num(seg.pct) %>%" title="<%= seg.count %> <%= seg.status %>"></span><% end %>
              </span>
              <% row.ticks.each do |tick| %><i class="tick <%= tick.kind %>" style="left:<%= js_num(tick.pct) %>%" title="<%= tick.title %>"></i><% end %>
            </span>
            <% if row.bar_length.clamped %><span class="sbarmore" title="longer than the scale — see the count">&rsaquo;</span><% end %>
          </div>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
