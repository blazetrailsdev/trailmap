<!DOCTYPE html>
<html>
<head>
  <title>trailmap</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "application" %>
  <%= javascript_inline_importmap_tag %>
</head>
<body>
  <nav class="nav">
    <a class="nav-brand" href="<%= root_path %>"><span class="dot"></span>trailmap</a>
    <input type="checkbox" id="navToggle" class="nav-toggle">
    <label for="navToggle" class="nav-burger" aria-label="Menu"><span></span><span></span><span></span></label>
    <nav class="nav-links">
      <a href="<%= rfcs_path %>">RFCs</a>
      <a href="<%= backlog_path %>">Backlog</a>
      <a href="<%= dashboard_path %>">Fleet</a>
      <a href="<%= parity_graph_path %>">Parity</a>
      <a href="<%= audits_path %>">Audits</a>
      <a href="<%= deploys_path %>">Deploys</a>
      <a href="<%= sessions_path %>">Sessions</a>
      <a href="<%= search_path %>">Search</a>
    </nav>
  </nav>

  <main class="site-main">
    <div class="wrap">
      <%= yield %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">The task domain, served by Rails.</div>
  </footer>
</body>
</html>
