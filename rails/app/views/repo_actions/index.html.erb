<%= render "shared/repo_header" %>

<p class="muted">Up to <%= @limit %> of the last <%= @window_days %> days of this repository's work, from the
<code>events</code> table. Deploys and CI runs land here once RFC 0136 phase B gives them tables.</p>

<div class="box">
  <% if @rows.empty? %>
    <div class="empty">No events.</div>
  <% end %>
  <% @rows.each do |row| %>
    <div class="item-row">
      <span class="row-main">
        <span class="titleline">
          <span class="badge s-<%= row.verb %>"><%= row.verb %></span>
          <% if row.story_id.present? %>
            <a class="row-title" href="<%= repo_issue_path(@owner.login, @repo.name, row.story_id) %>"><%= row.story_title || row.story_id %></a>
          <% else %>
            <span class="row-title muted">(no story)</span>
          <% end %>
        </span>
        <div class="row-meta">
          <code><%= row.at %></code>
          <% if row.actor.present? %> &middot; <%= row.actor %><% end %>
          <% if row.pr.present? %> &middot; <%= row.pr %><% end %>
        </div>
      </span>
    </div>
  <% end %>
</div>
