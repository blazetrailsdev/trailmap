{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "rootDir": ".",
    "outDir": "dist",
    "plugins": [
      {
        "name": "@blazetrails/trails-tsc/ts-plugin",
        "viewsDir": "app/views"
      }
    ]
  },
  "include": [
    "app",
    "config",
    "db",
    ".trails/template-registry-augmentation.d.ts"
  ]
}
