<!-- Where the page reaches ringo, which is always through trailmap: a
     WebSocket for the event stream, a prefix for the controls, and the
     reviewer list the stream does not carry. On an element rather than in an
     inline <script> so the page needs no inline JavaScript. -->
<div id="fleetConfig" hidden data-socket-path="<%= socketPath %>" data-control-path="<%= controlPath %>" data-reviewers-path="<%= reviewersPath %>" data-read-path="<%= readPath %>"></div>

<div class="page-header">
  <h1 class="page-title">Fleet</h1>
  <div class="page-subhead">
    <span class="muted">Open PRs, panes, spawns and CI, live from ringo.</span>
  </div>
</div>

<% if (!relayConfigured) { %>
  <div class="card ci-fixer paused">
    <div class="card-head"><span class="card-title">No fleet data</span></div>
    <div class="field-note">This deployment has no ringo origin — neither the <code>ringo_base</code> setting nor <code>RINGO_BASE</code> — so trailmap has no ringo to relay. See docs/fleet-dashboard.md.</div>
  </div>
<% } %>

<div class="status-group" title="Connection status">
  <span class="pill" id="eventsPill" title="Dashboard event stream"><span class="connected off" id="eventsDot"></span><span class="ico">&#128225;</span><span class="label">events</span></span>
  <span class="pill" id="tmuxPill" title="tmux socket to agent panes"><span class="connected off" id="tmuxDot"></span><span class="ico">&#128421;</span><span class="label">tmux</span></span>
  <span id="mainCIPills"></span>
  <span class="pill" id="pullFailPill" style="display:none"><span class="connected off" id="pullFailDot"></span><span class="ico">&#11015;</span><span class="label" id="pullFailLabel">pull failed</span></span>
  <span id="agentPills"></span>
</div>

<div id="queueSection" class="card" style="display:none"></div>

<div id="askPanel" class="card ask-panel" style="display:none">
  <div class="card-head">
    <span class="card-title">&#128587; Agents waiting on you</span>
    <span class="field-note" id="askSummary"></span>
  </div>
  <div id="askBody"></div>
</div>

<div id="ciFixerPanel" class="card ci-fixer" style="display:none">
  <div class="card-head">
    <span class="card-title">&#128657; CI fixer</span>
    <span class="field-note" id="ciFixerSummary"></span>
  </div>
  <div id="ciFixerBody"></div>
</div>

<div class="card usage-group" id="usageGroup" style="display:none">
  <div class="card-head"><span class="card-title">Usage</span></div>
  <div class="usage-bar" id="usageBar" style="display:none"></div>
  <div class="usage-bar" id="codexUsageBar" style="display:none"></div>
</div>

<div class="card" id="spawnLoopPanel">
  <div class="card-head">
    <span class="card-title">Loop</span>
    <span class="card-head" id="slControls"></span>
  </div>
  <div class="card-row">
    <label class="field">Live cap <span class="field-note" id="slLiveNow"></span>
      <input id="slLiveCap" class="ctl num" type="number" min="1">
    </label>
    <label class="field">Queue cap <span class="field-note" id="slOpenNow"></span>
      <input id="slQueueCap" class="ctl num" type="number" min="1">
    </label>
    <label class="field" title="Minutes between ticks (min 1)">Interval (min)
      <input id="slStagger" class="ctl num" type="number" min="1" step="1">
    </label>
    <label class="field" title="Bundle mode: each tick spawns ONE worker for the whole next-bundle (a PR closing several stories). Off: one worker per single story.">Bundle
      <input id="slBundle" type="checkbox">
    </label>
    <span class="field-note" id="slLastSpawn"></span>
  </div>
  <div id="slBundleList" class="bundle-list" style="display:none"></div>
</div>

<div class="card" id="spawnPanel">
  <div class="card-head">
    <span class="card-title">Manual spawn</span>
    <select id="repo" class="ctl">
      <% if (repos.length === 0) { %>
        <option value="" disabled selected>no repos configured (FLEET_REPO_PATHS)</option>
      <% } %>
      <% for (const repo of repos) { %>
        <option value="<%= repo.path %>"><%= repo.name %></option>
      <% } %>
    </select>
    <span class="field-status" id="spawnStatus"></span>
    <button class="btn btn-red btn-sm" id="pokeBtn" data-action="poke" data-panes="" title="Send &quot;keep going&quot; to every red (API-error / stuck-retry) agent" style="display:none;margin-left:auto">poke stalled agents</button>
  </div>
  <% for (const [from, name] of [["codex", "Codex"], ["claude", "Claude"]]) { %>
    <div class="card-head" id="drain<%= name %>Field" style="display:none" title="<%= name %> out of usage for a while? Move every <%= from %> reviewer that still owes a review onto the other agent, killing its stranded pane first.">
      <span class="field-note">Stranded reviewers</span>
      <button class="btn btn-sm" data-action="drain-reviewers" data-from="<%= from %>" data-status="drain<%= name %>Status">Drain <%= from %></button>
      <span class="field-status" id="drain<%= name %>Status"></span>
    </div>
  <% } %>
  <div class="spawn-form">
    <textarea id="task" class="ctl" placeholder="Enter a task for Claude..." rows="1"></textarea>
    <button id="spawn" class="btn btn-green">Spawn</button>
  </div>
</div>

<div id="repoSections"></div>

<script src="/assets/javascripts/dashboard.js" type="module"></script>
