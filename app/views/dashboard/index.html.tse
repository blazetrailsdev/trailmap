<!-- The SSE endpoint is configuration, not a constant: trailmap is a separate
     origin from the Go process that owns the stream. It rides on an element
     rather than an inline <script> so the page needs no inline JavaScript. -->
<div id="fleetConfig" hidden data-events-url="<%= eventsUrl %>"></div>

<div class="page-header">
  <h1 class="page-title">Fleet</h1>
  <div class="page-subhead">
    <span class="muted">Open PRs, panes, spawns and CI, live from ringo.</span>
  </div>
</div>

<div class="status-group" title="Connection status">
  <span class="pill" id="eventsPill" title="Dashboard event stream"><span class="connected off" id="eventsDot"></span><span class="ico">&#128225;</span><span class="label">events</span></span>
  <span class="pill" id="tmuxPill" title="tmux socket to agent panes"><span class="connected off" id="tmuxDot"></span><span class="ico">&#128421;</span><span class="label">tmux</span></span>
  <span id="mainCIPills"></span>
  <span class="pill" id="pullFailPill" style="display:none"><span class="connected off" id="pullFailDot"></span><span class="ico">&#11015;</span><span class="label" id="pullFailLabel">pull failed</span></span>
  <span id="agentPills"></span>
</div>

<div id="ciFixerPanel" class="card ci-fixer" style="display:none">
  <div class="card-head">
    <span class="card-title">&#128657; CI fixer</span>
    <span class="field-note" id="ciFixerSummary"></span>
  </div>
  <div id="ciFixerBody"></div>
</div>

<div class="card" id="spawnPanel">
  <div class="card-head">
    <span class="card-title">Manual spawn</span>
    <select id="repo" class="ctl">
      <% if (repos.length === 0) { %>
        <option value="" disabled selected>no repos configured (FLEET_REPO_PATHS)</option>
      <% } %>
      <% for (const repo of repos) { %>
        <option value="<%= repo.path %>"><%= repo.name %></option>
      <% } %>
    </select>
    <span class="field-status" id="spawnStatus"></span>
  </div>
  <div class="spawn-form">
    <textarea id="task" class="ctl" placeholder="Enter a task for Claude..." rows="1"></textarea>
    <button id="spawn" class="btn btn-green">Spawn</button>
  </div>
</div>

<div id="repoSections"></div>

<script src="/assets/javascripts/dashboard.js" type="module"></script>
