<%= render({ partial: "shared/repo-header", locals: { repo: repo, owner: owner, nwo: nwo, tabs: tabs } }) %>

<div class="box">
  <div class="box-row"><strong>Default branch</strong> &middot; <code><%= repo.default_branch %></code></div>
  <div class="box-row"><strong>Checkout on this box</strong> &middot;
    <% if (repo.checkout_path) { %><code><%= repo.checkout_path %></code><% } else { %><span class="muted">not configured (FLEET_REPO_PATHS)</span><% } %>
  </div>
  <div class="box-row"><strong>Stories</strong> &middot; <%= storyCount %></div>
</div>

<h2>Where the work is</h2>
<p class="muted">Top-level directories this repository's stories cite, most-cited first.
trailmap does not read the checkout — these are <code>story_paths</code> rows.</p>
<div class="box">
  <% if (directories.length === 0) { %>
    <div class="empty">No story cites a path in this repository.</div>
  <% } %>
  <% for (const dir of directories) { %>
    <div class="item-row">
      <span class="row-main">
        <span class="titleline"><code class="row-title"><%= dir.name %></code><span class="tag prog"><%= dir.count %></span></span>
      </span>
    </div>
  <% } %>
</div>
