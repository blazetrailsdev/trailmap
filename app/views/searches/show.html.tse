<div class="page-header">
  <h1 class="page-title">Search</h1>
  <div class="page-subhead">
    <span class="muted">Stories and RFCs, by id, title and body.</span>
  </div>
</div>

<form class="search-form" action="<%= searchPath() %>" method="get" role="search">
  <input class="search-input" type="search" name="q" value="<%= asked %>" maxlength="<%= maxLength %>" placeholder="serialize, has_many, est-loc…" aria-label="Search stories and RFCs" autofocus>
  <button class="search-button" type="submit">Search</button>
</form>

<% if (phrase !== null) { %>
  <%= render({ partial: "shared/pager", locals: { pager: pager } }) %>

  <div class="box">
    <div class="box-header">
      <span class="muted"><%= pager.total %> <%= pager.total === 1 ? "result" : "results" %> for <strong><%= phrase %></strong></span>
    </div>
    <% if (hits.length === 0) { %>
      <div class="empty">Nothing mentions <strong><%= phrase %></strong>.</div>
    <% } %>
    <% for (const hit of hits) { %>
      <div class="item-row">
        <%= render({ partial: "shared/status-badge", locals: { status: hit.status } }) %>
        <span class="row-main">
          <span class="titleline">
            <a class="row-title" href="<%= hit.kind === "rfc" ? rfcPath(hit.id) : storyPath(hit.id) %>"><%= hit.title %></a>
            <span class="tag"><%= hit.kind === "rfc" ? "RFC" : "story" %></span>
            <% if (hit.mentions > 0) { %><span class="tag" title="mentions in the body"><%= hit.mentions %>&times;</span><% } %>
          </span>
          <div class="row-meta">
            <code><%= hit.id %></code><% if (hit.rfcId) { %> &middot; <a href="<%= rfcPath(hit.rfcId) %>">RFC <%= hit.rfcId %></a><% } %>
          </div>
          <% if (hit.snippet) { %><div class="row-meta search-snippet"><%= hit.snippet %></div><% } %>
        </span>
      </div>
    <% } %>
  </div>

  <%= render({ partial: "shared/pager", locals: { pager: pager } }) %>
<% } else if (tooShort) { %>
  <div class="box"><div class="empty">Search for at least <%= minLength %> characters.</div></div>
<% } %>
