<%= render({ partial: "shared/repo-header", locals: { repo: repo, owner: owner, nwo: nwo, tabs: tabs } }) %>

<p class="muted">An RFC is this domain's project board. The done/total count is the RFC's own —
not this repository's slice of it, which would call a forty-story project finished.</p>

<div class="box">
  <% if (rows.length === 0) { %>
    <div class="empty">No RFC has work in this repository.</div>
  <% } %>
  <% for (const row of rows) { %>
    <div class="item-row">
      <span class="row-main">
        <span class="titleline">
          <a class="row-title" href="<%= repoProjectPath(owner.login, repo.name, row.id) %>"><%= row.title %></a>
          <%= render({ partial: "shared/status-badge", locals: { status: row.status } }) %>
          <% if (row.priority !== null) { %><span class="tag prio">P<%= row.priority %></span><% } %>
          <% if (row.counts.total > 0) { %><span class="tag prog" title="stories done / total"><%= row.counts.done %>/<%= row.counts.total %> done</span><% } %>
          <span class="tag" title="stories scoped to this repository"><%= row.mine %> here</span>
        </span>
        <div class="row-meta"><code><%= row.id %></code> &middot; <a href="<%= rfcPath(row.id) %>">RFC page</a></div>
        <% if (row.bar.length > 0) { %>
          <div class="sbarwrap">
            <span class="sbartrack">
              <span class="sbar" style="width:100%">
                <% for (const seg of row.bar) { %><span class="seg s-<%= seg.status %>" style="width:<%= seg.pct %>%" title="<%= seg.count %> <%= seg.status %>"></span><% } %>
              </span>
            </span>
          </div>
        <% } %>
      </span>
    </div>
  <% } %>
</div>
