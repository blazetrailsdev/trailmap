<%= render({ partial: "shared/repo-header", locals: { repo: repo, owner: owner, nwo: nwo, tabs: tabs } }) %>

<% if (rfc === null) { %>
  <div class="box"><div class="empty">No RFC <code><%= id %></code>.</div></div>
<% } else { %>
  <div class="page-header">
    <h1 class="page-title"><%= rfc.title ?? rfc.id %>
      <%= render({ partial: "shared/status-badge", locals: { status: rfc.status } }) %>
    </h1>
    <div class="page-subhead"><span class="muted"><code><%= rfc.id %></code> &middot;
      <a href="/rfc/<%= rfc.id %>">RFC page</a></span></div>
  </div>

  <p class="muted">This repository's stories only, by status.</p>
  <% if (columns.length === 0) { %>
    <div class="box"><div class="empty">No story of this RFC belongs to this repository.</div></div>
  <% } %>
  <% for (const column of columns) { %>
    <h2><%= render({ partial: "shared/status-badge", locals: { status: column.status } }) %>
      <span class="muted"><%= column.stories.length %></span></h2>
    <div class="box">
      <% for (const story of column.stories) { %>
        <div class="item-row">
          <span class="row-main">
            <span class="titleline">
              <a class="row-title" href="/<%= nwo %>/issues/<%= story.id %>"><%= story.title %></a>
            </span>
            <div class="row-meta"><code><%= story.id %></code></div>
          </span>
        </div>
      <% } %>
    </div>
  <% } %>
<% } %>
