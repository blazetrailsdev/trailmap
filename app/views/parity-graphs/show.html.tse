<!-- ringo's chart engine, as files rather than inline: trailmap's pages carry
     no inline JavaScript, and these two are GENERATED from the pinned ringo
     snapshot by scripts/vendor-ringo.sh and copied into public/assets by
     scripts/build-assets.sh. A <link> and a deferred <script> in the body are
     both valid here, and the layout has no per-page head slot. -->
<link rel="stylesheet" href="/assets/stylesheets/ringo-parity.css">

<div class="page-header">
  <h1 class="page-title">Parity over time</h1>
  <div class="page-subhead">
    <span class="muted">
      Per-package comparison results from every merged trails PR, rolled up to
      the last run of each day.
    </span>
  </div>
</div>

<% if (!statsConfigured) { %>
  <div class="card">
    <div class="card-head"><span class="card-title">No stats database</span></div>
    <div class="field-note">
      This deployment has no <code>STATS_DB</code>, so there are no comparison
      results to chart. Point it at the stats database the nightly stats-sync
      cron fills. Every other page is unaffected — see
      <code>config/initializers/stats-database.ts</code>.
    </div>
  </div>
<% } else { %>
  <%= render({ partial: "parity-graphs/cards" }) %>
  <script src="/assets/javascripts/ringo-parity.js" defer></script>
<% } %>
