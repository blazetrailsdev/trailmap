<!-- ringo's chart engine, as files rather than inline: trailmap's pages carry
     no inline JavaScript, and these two are GENERATED from the pinned ringo
     snapshot by scripts/vendor-ringo.sh and built by `vite build`
     (vite.config.ts) into public/assets under hashed names. A <link> and a
     deferred <script> in the body are both valid here, and the layout has no
     per-page head slot. -->
<%= stylesheetLinkTag("parity") %>

<div class="page-header">
  <h1 class="page-title">Parity over time</h1>
  <div class="page-subhead">
    <span class="muted">
      Per-package comparison results from every merged trails PR, rolled up to
      the last run of each day.
    </span>
  </div>
</div>

<% if (!charted) { %>
  <div class="card">
    <div class="card-head"><span class="card-title">Nothing projected yet</span></div>
    <div class="field-note">
      <% if (canRefresh) { %>
        The <code>parity_days</code> projection is empty. It fills itself on the
        first page load, so a refresh of this page should do it — or run
        <code>pnpm parity:sync</code> to fill it now.
      <% } else { %>
        The <code>parity_days</code> projection is empty, and this deployment has
        no <code>STATS_DB</code> to fill it from. Run <code>pnpm parity:sync</code>
        from a host that has the stats database, pointed at this hub. The chart
        itself needs only the projection — see
        <code>config/initializers/stats-schema.ts</code>.
      <% } %>
    </div>
  </div>
<% } else { %>
  <%= render({ partial: "parity-graphs/cards" }) %>
  <script src="<%= javascriptPath("parity-draw") %>" defer></script>
<% } %>
