<div class="page-header">
  <h1 class="page-title"><a href="/packages"><%= name %></a> &middot; deviations</h1>
  <div class="page-subhead"><span class="muted">at <a href="https://github.com/blazetrailsdev/trails/commit/<%= sha %>"><code><%= sha.slice(0, 10) %></code></a> &middot; <a href="/packages/<%= name %>/files">files</a></span></div>
</div>

<h2 class="section-title">Receipts</h2>
<% if (tags.length === 0) { %><div class="empty">None.</div><% } %>
<% for (const tag of tags) { %>
  <details class="pkg-tag">
    <summary><code><%= tag.tag %></code><% if (tag.receipt !== null && tag.receipt !== "none") { %> <span class="tag"><%= tag.receipt %></span><% } %> <strong><%= tag.count %></strong></summary>
    <ul>
      <% for (const site of sitesByTag.get(`${tag.tag} ${tag.receipt ?? ""}`) ?? []) { %>
        <li><a href="<%= blob %>/<%= site.file %>#L<%= site.line %>"><code><%= site.file %>:<%= site.line %></code></a><% if (site.declaration !== null) { %> <span class="muted"><%= site.declaration %></span><% } %></li>
      <% } %>
    </ul>
  </details>
<% } %>

<h2 class="section-title">Marks and baselines</h2>
<% if (marks.length === 0) { %><div class="empty">None.</div><% } %>
<table class="pkg-table">
  <% for (const mark of marks) { %>
    <tr><td><code><%= mark.mark %></code></td><td><strong><%= mark.latest %></strong></td><td><svg class="sparkline" width="80" height="16" viewBox="0 0 80 16"><polyline fill="none" stroke="currentColor" points="<%= mark.points %>"/></svg></td></tr>
  <% } %>
</table>

<h2 class="section-title">Permanently skipped tests</h2>
<% if (skips.size === 0) { %><div class="empty">None.</div><% } %>
<% for (const [anchor, tests] of skips) { %>
  <h3><a href="#<%= anchor %>"><%= anchor === "" ? "(no section cited)" : anchor %></a> <span class="muted"><%= tests.length %></span></h3>
  <ul>
    <% for (const test of tests) { %><li><code><%= test.file %></code> <%= test.test_name %></li><% } %>
  </ul>
<% } %>

<h2 class="section-title">Open surfaced deviations <span class="muted"><%= surfaced.length %></span></h2>
<% if (surfaced.length === 0) { %><div class="empty">None.</div><% } %>
<ul>
  <% for (const story of surfaced) { %><li><a href="/story/<%= story.id %>"><%= story.id %></a> <span class="muted"><%= story.title %></span></li><% } %>
</ul>

<h2 class="section-title">Works differently than you'd expect</h2>
<% if (sections.length === 0) { %><div class="empty">None.</div><% } %>
<% for (const section of sections) { %>
  <div class="card" id="<%= section.anchor %>">
    <div class="card-head"><a class="card-title" href="<%= blob %>/<%= section.file %>#<%= section.anchor %>"><%= section.heading %></a> <span class="muted"><%= section.file %></span></div>
    <div class="field-note"><%= section.lede %></div>
  </div>
<% } %>
