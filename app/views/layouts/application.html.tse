<!DOCTYPE html>
<html>
<head>
  <title>trailmap</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrfMetaTags() %>
  <%= stylesheetLinkTag("application") %>
</head>
<body>
  <nav class="nav">
    <a class="nav-brand" href="/"><span class="dot"></span>trailmap</a>
    <input type="checkbox" id="navToggle" class="nav-toggle">
    <label for="navToggle" class="nav-burger" aria-label="Menu"><span></span><span></span><span></span></label>
    <nav class="nav-links">
      <a href="/rfcs">RFCs</a>
      <a href="/backlog">Backlog</a>
      <a href="/dashboard">Fleet</a>
      <a href="/graphs/parity">Parity</a>
      <a href="/audits">Audits</a>
      <a href="/deploys">Deploys</a>
    </nav>
  </nav>

  <main class="site-main">
    <div class="wrap">
      <%= yield %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">The task domain, served by trails.</div>
  </footer>
</body>
</html>
