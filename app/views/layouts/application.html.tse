<!DOCTYPE html>
<html>
<head>
  <title>trailmap</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16">
  <link rel="icon" href="/mark.svg" type="image/svg+xml">
  <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <%= csrfMetaTags() %>
  <%= await viteStylesheetTag("~/stylesheets/application.css") %>
  <script src="<%= await viteAssetPath("application.js") %>" type="module"></script>
  <%= yield("head") %>
</head>
<body>
  <% const navItems = [["RFCs", rfcsPath()], ["Backlog", backlogPath()], ["Dashboard", dashboardPath()], ["Parity", parityGraphPath()], ["Packages", packagesPath()], ["Audits", auditsPath()], ["Deploys", deploysPath()], ["Sessions", sessionsPath()], ["Search", searchPath()]].map(([label, path]) => [label, path, navMark(path)] as const); %>
  <% const navCurrent = navItems.find(([, , mark]) => mark)?.[0] ?? ""; %>
  <% const pr = previewPr(); if (pr !== null) { %>
    <div class="preview-banner" role="status">Preview of <a href="https://github.com/blazetrailsdev/trailmap/pull/<%= pr %>">trailmap#<%= pr %></a>, built from its head. The data is a copy of production; changes made here are not kept.</div>
  <% } %>
  <nav class="nav">
    <a class="nav-brand" href="<%= rootPath() %>"><%= imageTag("/mark.svg", { size: 24, alt: "" }) %>trailmap</a>
    <span class="nav-current" aria-hidden="true"><%= navCurrent %></span>
    <input type="checkbox" id="navToggle" class="nav-toggle">
    <label for="navToggle" class="nav-burger" aria-label="Menu"><span></span><span></span><span></span></label>
    <nav class="nav-links">
      <% for (const [label, path, mark] of navItems) { %>
        <a href="<%= path %>"<% if (mark) { %> class="active"<% } %><% if (mark === "page") { %> aria-current="page"<% } %>><%= label %></a>
      <% } %>
    </nav>
  </nav>

  <main class="site-main">
    <div class="wrap">
      <%= yield %>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">The task domain, served by trails.</div>
  </footer>
</body>
</html>
