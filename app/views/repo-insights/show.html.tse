<%= render({ partial: "shared/repo-header", locals: { repo: repo, owner: owner, nwo: nwo, tabs: tabs } }) %>

<div class="box">
  <div class="box-row"><strong>Stories</strong> &middot; <%= storyCount %></div>
  <div class="box-row"><strong>Open estimate</strong> &middot; <%= openEstimate %> loc</div>
  <div class="box-row"><strong>Last <%= windowDays %> days</strong> &middot;
    <%= recentCount %> events, <%= doneCount %> done</div>
</div>

<h2>Stories by status</h2>
<div class="box">
  <% if (statuses.length === 0) { %>
    <div class="empty">No stories.</div>
  <% } %>
  <% for (const row of statuses) { %>
    <div class="box-row">
      <%= render({ partial: "shared/status-badge", locals: { status: row.status } }) %>
      <span class="muted"><%= row.count %></span>
    </div>
  <% } %>
</div>

<h2>Activity by verb <span class="muted">(last <%= windowDays %> days)</span></h2>
<div class="box">
  <% if (verbs.length === 0) { %>
    <div class="empty">Nothing moved in the window.</div>
  <% } %>
  <% for (const row of verbs) { %>
    <div class="box-row"><code><%= row.verb %></code> &middot; <%= row.count %></div>
  <% } %>
</div>
