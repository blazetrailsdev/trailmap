<div class="page-header">
  <h1 class="page-title">Audits</h1>
  <div class="page-subhead">
    <span class="muted">Agent-written progress reports, newest first. Report cards and refinements are on ringo.</span>
  </div>
</div>

<% if (audits.length === 0) { %>
  <div class="card">
    <div class="card-head"><span class="card-title">No audits yet</span></div>
    <div class="field-note">Agents write audits (markdown or self-contained HTML).</div>
  </div>
<% } else { %>
  <div class="audits-layout">
    <div class="audits-side">
      <div class="audits-group">Audits <span class="muted"><%= audits.length %></span></div>
      <% for (const audit of audits) { %>
        <a class="audit-item<%= audit.id === selected.id ? " active" : "" %>" href="<%= auditPath(audit) %>">
          <span class="audit-title"><%= audit.title %></span>
          <time class="muted" datetime="<%= audit.when.utc().iso8601(3) %>"><%= audit.when.utc().iso8601().slice(0, 16).replace("T", " ") %></time>
        </a>
      <% } %>
    </div>
    <div class="audits-viewer" data-audit-viewer>
      <div class="audits-fs"><button type="button" class="btn btn-sm" data-audit-fullscreen hidden>Fullscreen</button></div>
      <% if (body !== null) { %>
        <article class="markdown audits-doc"><%= body %></article>
      <% } else { %>
        <div class="audits-frame">
          <iframe sandbox="allow-scripts" src="<%= rawAuditPath(selected) %>" title="<%= selected.title %>"></iframe>
        </div>
      <% } %>
    </div>
  </div>
  <script src="<%= await viteAssetPath("audits.js") %>" type="module"></script>
<% } %>
