<div class="card">
  <div class="card-head">
    <span class="card-title">Timeline</span>
    <span class="muted"><%= timeline.events %> events, oldest first — gaps between events over <%= timeline.gap_floor %>, and silences inside a session over <%= timeline.quiet_floor %>, are drawn as waits</span>
  </div>
  <div class="tl-card">
    <div class="tl-totals">
      <div class="t"><div class="n"><%= timeline.elapsed %></div><div class="l">wall clock, first event to last</div></div>
      <div class="t"><div class="n"><%= timeline.working %></div><div class="l">agent &amp; reviewer sessions live</div></div>
      <div class="t"><div class="n wait"><%= timeline.waiting %></div><div class="l">waiting between events</div></div>
    </div>
    <div class="tl">
      <% for (const row of timeline.rows) { %>
        <% if (row.wait) { %>
          <div class="tl-wait"><span class="w"><%= row.wait %></span></div>
        <% } else { %>
          <div class="tl-ev k-<%= row.kind %>">
            <div class="tl-line">
              <span class="tl-when"><%= row.when %></span>
              <span class="tl-title"><%= row.title %></span>
              <% if (row.ran) { %><span class="tl-dur">ran <%= row.ran %></span><% } %>
              <% if (row.active) { %><span class="tl-dur tl-active">active <%= row.active %></span><% } %>
              <% for (const meta of row.meta ?? []) { %><span class="tl-meta"><%= meta %></span><% } %>
            </div>
            <% if (row.slow) { %><div class="tl-slow">slowest: <%= row.slow %></div><% } %>
            <% if (row.body_html) { %>
              <details class="tl-body"<%= row.open ? " open" : "" %>><summary><%= row.open ? "hide" : "read" %></summary><div class="md"><%= htmlSafe(row.body_html) %></div></details>
            <% } else if (row.body) { %>
              <details class="tl-body"><summary>read</summary><pre class="raw"><%= row.body %></pre></details>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>
