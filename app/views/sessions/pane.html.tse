<div class="page-header">
  <h1 class="page-title"><%= name %></h1>
  <div class="page-subhead">
    <span class="muted"><%= humanBytes(read.bytes.length) %> of capture replayed to <%= lines %> lines of scrollback. This is the pane's final screen state, not every frame: the agent redraws its UI in place, so intermediate repaints overwrite rather than stack — the same thing you would see scrolling back through the live pane.</span>
    <a href="/sessions/file?p=<%= encodeURIComponent(p) %>">Download the raw capture</a>
  </div>
</div>

<% if (read.truncated) { %>
  <div class="card ci-fixer paused">Capture is <%= humanBytes(read.total) %> — showing the last <%= humanBytes(maxBytes) %>. The download link above has the whole thing.</div>
<% } %>

<pre class="terminal"><%= html %></pre>
