<%#
  ringo's transcript page (webhook/transcript_page.go), over the reader it
  runs: `tr` is `core.ParseTranscript`'s answer. The markup and its order are
  ringo's; the class names carry `tx-` so they cannot collide with this
  stylesheet's own `.stat`, `.note` and `.bar`.
%>
<% const title = tr.Title || `session ${shortId(tr.SessionID)}`; %>
<% const wall = wallMs(tr); %>
<% const toolMs = tr.ToolTime / 1e6; %>
<% const turns = tr.Turns ?? []; %>
<% const counts = Object.entries(tr.ToolCounts).sort(([a, x], [b, y]) => y - x || (a < b ? -1 : a > b ? 1 : 0)); %>
<% const slowest = tr.Slowest ?? []; %>
<div class="page-header">
  <h1 class="page-title"><%= title %> <span class="session-role <%= reviewedFrom(tr.CWD) ? "reviewer" : "agent" %>"><%= reviewedFrom(tr.CWD) ? "reviewer" : "agent" %></span></h1>
  <div class="tx-meta">
    <% for (const [k, v] of [["session", shortId(tr.SessionID)], ["model", tr.Model], ["branch", tr.Branch], ["cwd", tr.CWD], ["claude", tr.Version]]) { %>
      <% if (v) { %><span><%= k %> <span class="mono"><%= v %></span></span><% } %>
    <% } %>
  </div>
</div>

<div class="tx-stats">
  <div class="tx-stat"><div class="n"><%= shortDur(wall) %></div><div class="l">wall clock</div></div>
  <div class="tx-stat"><div class="n"><%= turns.length %></div><div class="l"><%= plural(turns.length, "prompt", "prompts") %></div></div>
  <div class="tx-stat"><div class="n"><%= tr.ToolCalls %></div><div class="l">tool calls</div></div>
  <% if (toolMs > 0) { %>
    <div class="tx-stat"><div class="n"><%= toolDur(toolMs) %></div><div class="l"><%= wall > 0 ? `in tools (${Math.trunc((100 * toolMs) / wall)}% of wall)` : "in tools" %></div></div>
  <% } %>
  <div class="tx-stat"><div class="n<%= tr.Errors > 0 ? " err" : "" %>"><%= tr.Errors %></div><div class="l"><%= plural(tr.Errors, "error", "errors") %></div></div>
  <% if (tr.Cost > 0) { %>
    <div class="tx-stat"><div class="n"><%= money(tr.Cost) %></div><div class="l">list-price equiv.</div></div>
  <% } %>
</div>

<% if (counts.length > 0) { %>
  <div class="card">
    <div class="card-head"><div class="card-title">Tool mix</div></div>
    <div class="tx-mix">
      <% for (const [name, n] of counts) { %>
        <div class="mono"><%= name %></div><div><div class="tx-bar" style="width:<%= Math.trunc((100 * n) / counts[0][1]) %>%"></div></div><div class="muted"><%= n %></div>
      <% } %>
    </div>
  </div>
<% } %>

<% if (slowest.length > 0) { %>
  <div class="card">
    <div class="card-head">
      <div class="card-title">Where the time went</div>
      <div class="field-note"><%= toolDur(toolMs) %> of tool wall clock across <%= tr.ToolCalls %> calls — the slowest are listed</div>
    </div>
    <div class="tx-mix tx-spent">
      <% for (const c of slowest) { %>
        <div><%= toolDur(callMs(c)) %></div><div><div class="tx-bar slow" style="width:<%= Math.trunc((100 * callMs(c)) / callMs(slowest[0])) %>%"></div></div><div class="tx-what mono"><%= c.Name %> <span class="muted"><%= c.Summary || firstLine(c.Input) %></span></div>
      <% } %>
    </div>
  </div>
<% } %>

<% if (tr.Oversized > 0) { %>
  <div class="field-note"><%= tr.Oversized %> <%= plural(tr.Oversized, "line", "lines") %> over 4 MB could not be read and <%= plural(tr.Oversized, "is", "are") %> left out.</div>
<% } %>
<% if (firstLineTooLong) { %>
  <div class="field-note">The session's first line alone is longer than <%= humanBytes(maxBytes) %>, so nothing could be read here. The download link at the foot of the page has the whole thing.</div>
<% } else if (cut) { %>
  <div class="field-note">Session is longer than trailmap reads on one request — showing its first <%= humanBytes(maxBytes) %>. The download link at the foot of the page has the whole thing.</div>
<% } %>
<% if (tr.Truncated) { %>
  <div class="field-note">Session is longer than this page renders — showing the first 20,000 steps.</div>
<% } %>

<% turns.forEach((turn, i) => { %>
  <div class="tx-turn">
    <% if (turn.Prompt) { %>
      <div class="tx-prompt"><div class="tx-who">prompt <%= i + 1 %><%= clock(turn.At) ? ` · ${clock(turn.At)}` : "" %></div><div class="tx-body"><%= turn.Prompt %></div></div>
    <% } %>
    <% if ((turn.Steps ?? []).length > 0) { %>
      <div class="tx-steps">
        <% for (const s of turn.Steps ?? []) { %>
          <% if (s.Kind === "text") { %>
            <div class="tx-step say"><% if (clock(s.At)) { %><div class="muted mono"><%= clock(s.At) %></div><% } %><div class="tx-body"><%= s.Text %></div></div>
          <% } else if (s.Kind === "thinking") { %>
            <div class="tx-step"><details class="tx-think"><summary>thinking</summary><div class="tx-body"><%= s.Text %></div></details></div>
          <% } else if (s.Kind === "note") { %>
            <div class="tx-step"><div class="field-note"><%= s.Text %></div></div>
          <% } else if (s.Tool) { %>
            <% const c = s.Tool; const ms = callMs(c); %>
            <div class="tx-step tool<%= c.IsError ? " err" : "" %>"><div class="tx-tool">
              <div class="tx-tool-head">
                <span class="tx-tool-name"><%= c.Name %></span>
                <% if (c.Summary) { %><span class="tx-tool-sum"><%= c.Summary %></span><% } %>
                <span class="tx-tool-meta"><% if (clock(c.StartedAt)) { %><span class="muted"><%= clock(c.StartedAt) %></span> · <% } %><% if (ms > 0) { %><span class="<%= ms >= 10_000 ? "tx-slow" : "" %>"><%= toolDur(ms) %><%= ms >= 10_000 ? " slow" : "" %></span><% } %><% if (c.Unpaired) { %>no result<% } else if (c.IsError) { %> · error · <%= humanBytes(c.OutBytes) %><% } else if (c.OutBytes > 0) { %> · <%= humanBytes(c.OutBytes) %><% } %></span>
              </div>
              <% if (c.Input) { %><pre class="tx-io"><%= clip(c.Input, 8000) %></pre><% } %>
              <% if (c.Unpaired) { %>
                <div class="tx-io out tx-none">no result — the session ended before this call returned</div>
              <% } else if (c.Output.trim() === "") { %>
                <div class="tx-io out tx-none">(no output)</div>
              <% } else { %>
                <% const out = clip(c.Output, 200 << 10); %>
                <% if (byteLength(out) <= 1200) { %>
                  <pre class="tx-io out<%= c.IsError ? " err" : "" %>"><%= out %></pre>
                <% } else { %>
                  <details class="tx-fold"><summary><%= humanBytes(byteLength(c.Output)) %> of output</summary><pre class="tx-io out<%= c.IsError ? " err" : "" %>"><%= out %></pre></details>
                <% } %>
              <% } %>
            </div></div>
          <% } %>
        <% } %>
      </div>
    <% } %>
  </div>
<% }); %>

<p class="muted">Rendered from the archived JSONL: <%= tr.Skipped %> bookkeeping events (attachments, mode latches, snapshots) are not shown. <a href="<%= sessionsFilePath({ p: p }) %>">Download the raw transcript</a>.</p>
