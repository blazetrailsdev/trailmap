<% const split = archive.roleSplit(); %>
<% if (split.agents + split.reviewers === 0) { %>
  <% if (archive.transcripts.length === 0) { %><span class="muted">—</span><% } else { %><%= archive.transcripts.length %><% } %>
<% } else { %>
  <% if (split.agents > 0) { %><%= split.agents %> <span class="session-role agent">agent</span><% } %>
  <% if (split.agents > 0 && split.reviewers > 0) { %> · <% } %>
  <% if (split.reviewers > 0) { %><%= split.reviewers %> <span class="session-role reviewer">reviewer</span><% } %>
  <% if (split.passes > split.agents + split.reviewers) { %> <span class="muted">· <%= split.passes %> passes</span><% } %>
<% } %>
