<%= render({ partial: "shared/repo-header", locals: { repo: repo, owner: owner, nwo: nwo, tabs: tabs } }) %>

<p class="muted">Up to <%= limit %> of the last <%= windowDays %> days of this repository's work, from the
<code>events</code> table. Deploys and CI runs land here once RFC 0136 phase B gives them tables.</p>

<div class="box">
  <% if (rows.length === 0) { %>
    <div class="empty">No events.</div>
  <% } %>
  <% for (const row of rows) { %>
    <div class="item-row">
      <span class="row-main">
        <span class="titleline">
          <span class="badge s-<%= row.verb %>"><%= row.verb %></span>
          <% if (row.storyId) { %>
            <a class="row-title" href="<%= repoIssuePath(owner.login, repo.name, row.storyId) %>"><%= row.storyTitle ?? row.storyId %></a>
          <% } else { %>
            <span class="row-title muted">(no story)</span>
          <% } %>
        </span>
        <div class="row-meta">
          <code><%= row.at %></code>
          <% if (row.actor) { %> &middot; <%= row.actor %><% } %>
          <% if (row.pr) { %> &middot; <%= row.pr %><% } %>
        </div>
      </span>
    </div>
  <% } %>
</div>
