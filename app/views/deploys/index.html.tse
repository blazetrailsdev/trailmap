<div class="page-header">
  <h1 class="page-title">Deploys</h1>
  <div class="page-subhead">
    <span class="muted">Every dokku deploy ringo has run, newest first. Read-only; the history is relayed from ringo, and each log is read from ringo's pane-log directory.</span>
  </div>
</div>

<% if (refreshing) { %>
  <!-- A deploy is running: deploys.js re-reads the page. Config as an
       element rather than an inline script, as on the pane page. -->
  <div id="deploysConfig" hidden data-refresh-ms="5000"></div>
<% } %>

<% if (problem !== null) { %>
  <div class="card ci-fixer paused">
    <div class="card-head"><span class="card-title">No deploy data</span></div>
    <div class="field-note"><%= problem %></div>
  </div>
<% } else if (runs.length === 0) { %>
  <div class="card"><div class="field-note">No deploys yet.</div></div>
<% } else { %>
  <div class="card deploys">
    <% for (const run of runs) { %>
      <div class="deploy-row">
        <span class="badge s-deploy-<%= run.status %>"><%= run.status %></span>
        <span class="deploy-app"><%= run.app %></span>
        <code class="muted"><%= run.sha %></code>
        <span class="deploy-msg"><%= run.message %></span>
        <% if (run.error) { %><span class="deploy-err"><%= run.error %></span><% } %>
        <time class="muted" datetime="<%= run.started %>"><%= run.started.slice(0, 16).replace("T", " ") %> UTC · <%= deployDuration(run.seconds) %></time>
        <details class="deploy-log" data-run="<%= run.id %>">
          <summary>log</summary>
          <pre data-src="<%= deployLogPath(run) %>"></pre>
          <a href="<%= deployLogPath(run) %>">raw</a>
        </details>
      </div>
    <% } %>
  </div>
<% } %>

<script src="<%= javascriptPath("deploys") %>" type="module"></script>
