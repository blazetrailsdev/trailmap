{
  "name": "trailmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.tse": {
      "types": "./.trails/views/*.tse.d.ts",
      "default": "./.trails/views/*.tse.js"
    }
  },
  "scripts": {
    "build": "TRAILS_ENV=${TRAILS_ENV:-test} trails-tsc --schema db/schema.ts --schema db/hub_schema.ts --schema db/statsSync_schema.ts=StatsSyncRecord",
    "test": "vitest run",
    "lint": "eslint",
    "gate": "tsx scripts/equivalence.ts",
    "smoke": "bash scripts/smoke-boot.sh",
    "gate:pages": "tsx scripts/page-equivalence.ts",
    "ringo:stub": "tsx scripts/ringo-stub.ts",
    "gate:lists": "tsx scripts/gate-ringo-lists.ts",
    "gate:parity": "tsx scripts/gate-ringo-parity.ts",
    "parity:sync": "tsx scripts/parity-sync.ts",
    "gate:markdown": "tsx scripts/gate-ringo-markdown.ts",
    "ringo:pin": "tsx scripts/ringo-pin-freshness.ts",
    "trails": "bin/trails",
    "dev": "bin/trails server",
    "db:create": "bin/trails db:create",
    "db:migrate": "bin/trails db:migrate",
    "db:seed": "bin/trails db:seed",
    "db:setup": "bin/trails db:create && bin/trails db:migrate && bin/trails db:seed",
    "db:reset": "bin/trails db:drop && bin/trails db:create && bin/trails db:migrate && bin/trails db:seed",
    "views": "NODE_ENV=test trails-tsc-views build --views app/views && NODE_ENV=test trails-tsc-views build --views test/fixtures/views --in-place",
    "gate:snapshot": "tsx scripts/gate-page-snapshot.ts"
  },
  "dependencies": {
    "@blazetrails/actionmailer": "0.1.0-alpha0.2",
    "@blazetrails/actionpack": "0.1.0-alpha0.2",
    "@blazetrails/actionview": "0.1.0-alpha0.2",
    "@blazetrails/activejob": "0.1.0-alpha0.2",
    "@blazetrails/activemodel": "0.1.0-alpha0.2",
    "@blazetrails/activerecord": "0.1.0-alpha0.2",
    "@blazetrails/activestorage": "0.1.0-alpha0.2",
    "@blazetrails/activesupport": "0.1.0-alpha0.2",
    "@blazetrails/date": "0.1.0-alpha0.2",
    "@blazetrails/pg": "0.1.0-alpha0.2",
    "@blazetrails/rack": "0.1.0-alpha0.2",
    "@blazetrails/ruby-compat": "0.1.0-alpha0.2",
    "@blazetrails/solid-queue": "0.1.0-alpha0.2",
    "@blazetrails/sqlite3": "0.1.0-alpha0.2",
    "@blazetrails/trailties": "0.1.0-alpha0.2",
    "@blazetrails/vite-assets": "0.1.0-alpha0.2",
    "@blazetrails/vite-trails": "0.1.0-alpha0.2",
    "@hotwired/turbo": "8.0.23",
    "@sentry/node": "^10.78.0",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "websocket-driver": "0.7.4"
  },
  "devDependencies": {
    "@blazetrails/activerecord-cli": "0.1.0-alpha0.2",
    "@blazetrails/trails-tsc": "0.1.0-alpha0.2",
    "eslint": "^10.0.3",
    "happy-dom": "20.0.10",
    "tsx": "^4.20.0",
    "typescript": "7.1.0-dev.20260920.1",
    "typescript-5": "npm:typescript@5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.0.0",
    "vite-plugin-ruby": "5.2.6",
    "vitest": "^3.0.0"
  }
}
