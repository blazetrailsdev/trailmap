{
  "name": "trailmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.tse": {
      "types": "./.trails/views/*.tse.d.ts",
      "default": "./.trails/views/*.tse.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "gate": "tsx scripts/equivalence.ts",
    "smoke": "bash scripts/smoke-boot.sh",
    "trails:track": "scripts/track-trails.sh",
    "gate:pages": "tsx scripts/page-equivalence.ts",
    "gate:lists": "tsx scripts/gate-ringo-lists.ts",
    "gate:parity": "tsx scripts/gate-ringo-parity.ts",
    "parity:sync": "tsx scripts/parity-sync.ts",
    "gate:markdown": "tsx scripts/gate-ringo-markdown.ts",
    "ringo:pin": "tsx scripts/ringo-pin-freshness.ts",
    "trails": "bin/trails",
    "dev": "bin/trails server",
    "db:create": "bin/trails db create",
    "db:migrate": "bin/trails db migrate",
    "db:seed": "bin/trails db seed",
    "db:setup": "bin/trails db create && bin/trails db migrate && bin/trails db seed",
    "db:reset": "bin/trails db drop && bin/trails db create && bin/trails db migrate && bin/trails db seed",
    "views": "trails-tsc-views build --views app/views && trails-tsc-views build --views test/fixtures/views --in-place",
    "gate:snapshot": "tsx scripts/gate-page-snapshot.ts"
  },
  "dependencies": {
    "@blazetrails/actionpack": "file:vendor/blazetrails-actionpack-0.1.0.tgz",
    "@blazetrails/actionview": "file:vendor/blazetrails-actionview-0.1.0.tgz",
    "@blazetrails/activejob": "file:vendor/blazetrails-activejob-0.1.0.tgz",
    "@blazetrails/activemodel": "file:vendor/blazetrails-activemodel-0.1.0.tgz",
    "@blazetrails/activerecord": "file:vendor/blazetrails-activerecord-0.1.0.tgz",
    "@blazetrails/activesupport": "file:vendor/blazetrails-activesupport-0.1.0.tgz",
    "@blazetrails/date": "file:vendor/blazetrails-date-0.1.0.tgz",
    "@blazetrails/rack": "file:vendor/blazetrails-rack-0.1.0.tgz",
    "@blazetrails/ruby-compat": "file:vendor/blazetrails-ruby-compat-0.1.0.tgz",
    "@blazetrails/solid-queue": "file:vendor/blazetrails-solid-queue-0.1.0.tgz",
    "@blazetrails/trailties": "file:vendor/blazetrails-trailties-0.1.0.tgz",
    "better-sqlite3": "^12.6.2",
    "pg": "^8.23.1",
    "websocket-driver": "0.7.4"
  },
  "devDependencies": {
    "@blazetrails/trails-tsc": "file:vendor/blazetrails-trails-tsc-0.1.0.tgz",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
